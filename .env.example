# Copie como .env.dev ou .env.prod. Nunca versione as chaves reais.
APP_ENV=dev
COMPOSE_PROJECT_NAME=cidade-dev
FIVEM_LICENSE_KEY=
PANEL_ADMIN_PASSWORD=
CITY_API_KEY=
PANEL_ADMIN_SECRET=
# URL exata do fx.tar.xz Linux, obtida nos artifacts oficiais Cfx.re.
FXSERVER_ARTIFACT_URL=
# SHA-256 do mesmo arquivo. Obrigatório em produção.
FXSERVER_ARTIFACT_SHA256=
CITY_IMAGE=cidade-fivem:local
# Host/IP divulgado pelo painel. Para amigos, use o IP do servidor ou da VPN.
SERVER_HOST=127.0.0.1
ISLAND_PORT=30220
CITY_PORT=30221
PANEL_PORT=8887
CAPTURE_PORT=8888
# No container, GTA_ROOT fica em /gta. GTA_HOST_PATH aponta para o GTA local.
GTA_HOST_PATH=./.state/gta
GTA_ROOT=/gta
BLENDER_BIN=/usr/bin/blender
ENABLE_CAPTURE_INDEX=0
